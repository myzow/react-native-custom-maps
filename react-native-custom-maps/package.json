{
  "name": "react-native-custom-maps",
  "version": "0.1.0",
  "description": "A React Native maps library with Fabric (New Architecture) support. Dual provider on Android (Google Maps / OpenStreetMap) and iOS (MapKit / Google Maps).",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "android/build.gradle",
    "android/src",
    "android/CMakeLists.txt",
    "ios",
    "cpp",
    "react-native-custom-maps.podspec",
    "README.md",
    "!**/__tests__",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "keywords": [
    "react-native",
    "maps",
    "fabric",
    "new-architecture",
    "google-maps",
    "openstreetmap",
    "mapkit",
    "ios",
    "android"
  ],
  "repository": "https://github.com/emergent-labs/react-native-custom-maps",
  "author": "Emergent Labs",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "18.3.1",
    "react-native": "0.83.4",
    "typescript": "^5.3.0"
  },
  "codegenConfig": {
    "name": "RNCustomMapsSpec",
    "type": "components",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.customaps"
    },
    "ios": {
      "componentProvider": {
        "RNCCustomMapsView": "RNCCustomMapsView"
      }
    }
  }
}
